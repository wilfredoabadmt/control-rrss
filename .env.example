# ==============================================================================
# GAMEA Social Monitor — Variables de Entorno de Configuración
# ==============================================================================

# Entorno: development | staging | production | testing
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="GAMEA Social Monitor"
API_V1_STR="/api/v1"

# Servidor Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80"]

# Base de Datos PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gamea_social_monitor
POSTGRES_USER=gamea_admin
POSTGRES_PASSWORD=gamea_secure_password_dev_change_in_prod
DATABASE_URL=postgresql+asyncpg://gamea_admin:gamea_secure_password_dev_change_in_prod@postgres:5432/gamea_social_monitor
DATABASE_URL_SYNC=postgresql+psycopg2://gamea_admin:gamea_secure_password_dev_change_in_prod@postgres:5432/gamea_social_monitor

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Seguridad y Criptografía (Principio XX)
# Clave JWT generada con: openssl rand -hex 32
JWT_SECRET_KEY=dev_secret_key_change_in_production_min_32_bytes_long_ok
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clave Fernet para cifrado de CI/document_number (32 bytes base64)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=0123456789012345678901234567890123456789012=

# Redes Sociales — Facebook Graph API (Meta)
FACEBOOK_APP_ID=mock_facebook_app_id
FACEBOOK_APP_SECRET=mock_facebook_app_secret
FACEBOOK_VERIFY_TOKEN=gamea_meta_webhook_verify_token
FACEBOOK_GRAPH_VERSION=v20.0

# Redes Sociales — TikTok API
TIKTOK_CLIENT_KEY=mock_tiktok_client_key
TIKTOK_CLIENT_SECRET=mock_tiktok_client_secret

# Rate Limiting & SlowAPI
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# Auditoría & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
